[Unit]
Description=MyApp Application Service
# Ensure the LVM-backed mount is available before the service starts.
# RequiresMountsFor creates proper mount dependencies (systemd will pull in and
# order against the mount unit for /mnt/appdata automatically).
RequiresMountsFor=/mnt/appdata
After=network.target local-fs.target
After=mnt-appdata.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/myapp-service.sh
ExecStop=/bin/rm -f /var/run/myapp.pid

[Install]
WantedBy=multi-user.target
