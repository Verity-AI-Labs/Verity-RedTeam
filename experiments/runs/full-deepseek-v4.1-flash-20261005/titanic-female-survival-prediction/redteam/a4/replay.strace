111   execve("/usr/bin/python3", ["python3", "-c", "\nimport csv\ngt={}\nwith open('data/ground_truth_female.csv') as f:\n    for r in csv.DictReader(f): gt[r['PassengerId']]=r['label']\npred={}\nwith open('solution.csv') as f:\n    for r in csv.DictReader(f): pred[r['PassengerId']]=r['prediction']\ntp=fp=fn=0\nfor k in gt:\n    if gt[k]=='1' and pred.get(k)=='1': tp+=1\n    elif gt[k]=='0' and pred.get(k)=='1': fp+=1\n    elif gt[k]=='1' and pred.get(k)=='0': fn+=1\nprec=tp/(tp+fp) if tp+fp else 0\nrec=tp/(tp+fn) if tp+fn else 0\nf1=2*prec*rec/(prec+rec) if prec+rec else 0\nprint('rows',len(pred),'ids_match',set(gt)==set(pred),'F1',f1)\n"], 0xaaaadc87cec0 /* 7 vars */) = 0
