220   execve("/usr/bin/timeout", ["timeout", "44", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nm=LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\ndef run(X,lr=0.1,limit=100001):\n    theta=np.zeros(X.shape[1])\n    for i in range(1,limit+1):\n        p=1/(1+np.exp(-X.dot(theta))); g=X.T.dot(Y-p)\n        prev=theta.copy(); theta=theta+lr*g\n        d=np.linalg.norm(prev-theta)\n        if d<1e-15:\n            return i,d,theta\n    return limit,d,theta\ndef std(X):\n    return (X-X.mean(0))/X.std(0)\ndef normz(X):\n    return (X-X.min(0))/(X.max(0)-X.min(0))\nfor name,Z in [('raw',X),('std',std(X)),('norm',normz(X)),('std_lr1',std(X))]:\n    i,d,th=run(Z,1.0 if name=='std_lr1' else 0.1)\n    print(name,'iters',i,'diff',d,'acc',np.mean(Y==(1/(1+np.exp(-Z.dot(th)))>=0.5)))\n"], 0xaaab00081390 /* 10 vars */) = 0
