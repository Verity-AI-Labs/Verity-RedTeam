288   execve("/usr/bin/timeout", ["timeout", "44", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nm=LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\ndef run(Z,lr,limit=100001):\n    theta=np.zeros(Z.shape[1])\n    for i in range(1,limit+1):\n        p=1/(1+np.exp(-Z.dot(theta))); g=Z.T.dot(Y-p)\n        prev=theta.copy(); theta=theta+lr*g\n        d=np.linalg.norm(prev-theta)\n        if d<1e-15: return i,d,theta\n    return limit,d,theta\ndef std(X): return (X-X.mean(0))/X.std(0)\ndef addi(X): return np.hstack([np.ones((X.shape[0],1)),X])\ncfgs={\n 'raw':X,\n 'std':std(X),\n 'raw+i':addi(X),\n 'std+i':addi(std(X)),\n}\nfor n,Z in cfgs.items():\n  for lr in (0.1,0.5,1.0,2.0):\n    i,d,th=run(Z,lr)\n    acc=np.mean(Y==(1/(1+np.exp(-Z.dot(th)))>=0.5))\n    print(f'{n} lr={lr} iters={i} diff={d:.2e} acc={acc:.4f}')\n"], 0xaaaabd4423f0 /* 10 vars */) = 0
