243   execve("/usr/bin/timeout", ["timeout", "40", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX, Y = LogisticRegression().load_csv('dataset.csv')\nfor lr in [1.0, 5.0, 10.0, 100.0, 1000.0]:\n    th = np.zeros(X.shape[1]); it=0; d=np.inf; gnorm=np.inf\n    while it<100000 and d>=1e-15:\n        it+=1\n        z = X.dot(th)\n        p = 1/(1+np.exp(-z))\n        g = X.T.dot(Y-p)\n        gnorm = np.linalg.norm(g)\n        nth = th + lr*g\n        d = np.linalg.norm(nth-th)\n        th=nth\n    p = 1/(1+np.exp(-X.dot(th)))\n    pred=(p>=0.5).astype(int)\n    print('lr',lr,'iters',it,'diff',d,'gnorm',gnorm,'acc',np.mean(pred==Y),'theta max',np.max(np.abs(th)))\n"], 0xaaaadd76e240 /* 10 vars */ <unfinished ...>
