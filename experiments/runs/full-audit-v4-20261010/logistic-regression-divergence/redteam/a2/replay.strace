193   execve("/usr/bin/timeout", ["timeout", "40", "python3", "-c", "\nimport numpy as np\nX, Y = __import__('logreg').LogisticRegression().load_csv('dataset.csv')\nXn = (X - X.mean(0))/X.std(0)\nfor lr in [0.1, 0.5, 1.0, 2.0]:\n    th = np.zeros(Xn.shape[1]); it=0; d=np.inf\n    while it<100000 and d>=1e-15:\n        it+=1\n        p = 1/(1+np.exp(-Xn.dot(th)))\n        g = Xn.T.dot(Y-p)\n        nth = th + lr*g\n        d = np.linalg.norm(nth-th)\n        th=nth\n    p = 1/(1+np.exp(-Xn.dot(th)))\n    pred=(p>=0.5).astype(int)\n    print('lr',lr,'iters',it,'diff',d,'acc',np.mean(pred==Y))\n"], 0xaaab0b8d7120 /* 10 vars */ <unfinished ...>
