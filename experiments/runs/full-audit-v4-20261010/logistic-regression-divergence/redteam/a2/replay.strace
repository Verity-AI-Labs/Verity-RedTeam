155   execve("/usr/bin/timeout", ["timeout", "40", "python3", "-c", "\nimport numpy as np\nm = None\nfrom logreg import LogisticRegression\n\n# check data scales and separability\nimport numpy as np\nX, Y = LogisticRegression().load_csv('dataset.csv')\nprint('mean', X.mean(0))\nprint('std', X.std(0))\nprint('Y counts', np.bincount(Y.astype(int)))\n# linear separability check via hard margin perceptron-ish / check logistic\n# Try small lr\nfor lr in [0.001, 0.01]:\n    mod = LogisticRegression()\n    th = np.zeros(X.shape[1])\n    it=0\n    prev=np.inf\n    while True:\n        it+=1\n        p = 1/(1+np.exp(-X.dot(th)))\n        g = X.T.dot(Y-p)\n        nth = th + lr*g\n        d = np.linalg.norm(nth-th)\n        th=nth\n        if it>=100000 or d<1e-15:\n            break\n    p = 1/(1+np.exp(-X.dot(th)))\n    pred=(p>=0.5).astype(int)\n    print('lr',lr,'iters',it,'diff',d,'acc',np.mean(pred==Y),'theta',th)\n"], 0xaaaaddbfd4c0 /* 10 vars */ <unfinished ...>
