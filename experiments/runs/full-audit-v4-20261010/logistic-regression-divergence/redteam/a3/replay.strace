291   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np\nm=__import__('logreg').LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\nfor name,Xs in [('raw',X),('std',(X-X.mean(0))/X.std(0)),('std+int',None)]:\n    if Xs is None:\n        Xs=m.add_intercept_fn((X-X.mean(0))/X.std(0))\n    for lr in [0.1,1.0,10.0]:\n        th=np.zeros(Xs.shape[1]); conv=None\n        for i in range(1,200001):\n            p=1/(1+np.exp(-Xs.dot(th)))\n            g=Xs.T.dot(Y-p)\n            nt=th+lr*g\n            d=np.linalg.norm(th-nt)\n            th=nt\n            if d<1e-15:\n                conv=i;break\n        print(name,'lr',lr,'conv_iters',conv,'finaldiff',np.linalg.norm(lr*Xs.T.dot(Y-1/(1+np.exp(-Xs.dot(th))))))\n"], 0xaaaafd9132d0 /* 10 vars */ <unfinished ...>
