564   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np\nX=np.loadtxt('dataset.csv',delimiter=',',skiprows=1,usecols=[0,1,2,3,4])\nY=np.loadtxt('dataset.csv',delimiter=',',skiprows=1,usecols=[5])\nfor name,Xs in [('raw',X),('std',(X-X.mean(0))/X.std(0))]:\n    th=np.zeros(Xs.shape[1])\n    for i in range(1,100001):\n        p=1/(1+np.exp(-np.clip(Xs.dot(th),-500,500)))\n        nt=th+0.1*Xs.T.dot(Y-p)\n        d=np.linalg.norm(th-nt); th=nt\n        if d<1e-15:\n            print(name,'converged at',i); break\n    else:\n        print(name,'NOT converged, final diff',d)\n"], 0xaaab0a1f9120 /* 10 vars */ <unfinished ...>
