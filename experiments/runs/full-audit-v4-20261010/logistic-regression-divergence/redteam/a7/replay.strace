428   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np, logreg\nm=logreg.LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\nfor std in [0,1]:\n  Xs=(X-X.mean(0))/X.std(0) if std else X\n  for norm in [0,1]:\n    for lr in [0.1,0.5,1,2,5,10,20,50]:\n      th=np.zeros(Xs.shape[1]); last=None\n      for i in range(1,100001):\n        z=Xs.dot(th); z=np.clip(z,-500,500)\n        p=1/(1+np.exp(-z))\n        g=Xs.T.dot(Y-p)\n        if norm: g=g/Xs.shape[0]\n        pt=th.copy(); th=th+lr*g\n        d=np.linalg.norm(pt-th)\n        if d<1e-15: last=(i,d); break\n      print('std',std,'norm',norm,'lr',lr,'conv',last,'finald',d)\n"], 0xaaaaf79551e0 /* 10 vars */ <unfinished ...>
