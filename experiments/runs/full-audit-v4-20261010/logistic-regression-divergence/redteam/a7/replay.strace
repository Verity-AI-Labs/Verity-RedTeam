862   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np, logreg\nm=logreg.LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\nrng=np.random.default_rng(0); idx=rng.permutation(len(Y)); tr,te=idx[:90],idx[90:]\nfor it in [21,100,1000,100000]:\n  th=np.zeros(X.shape[1])\n  for i in range(1,it+1):\n    p=1/(1+np.exp(-X.dot(th))); g=X.T.dot(Y-p); th=th+0.1*g\n  ptr=(X[tr].dot(th)>=0)  # sign via prob>=0.5 => X.dot>=0\n  pred=np.where(1/(1+np.exp(-X[te].dot(th)))>=0.5,1,0)\n  print('iters',it,'trainacc',np.mean((1/(1+np.exp(-X[tr].dot(th)))>=0.5)==Y[tr]),'testacc',np.mean(pred==Y[te]))\n"], 0xaaaafe4de120 /* 10 vars */) = 0
