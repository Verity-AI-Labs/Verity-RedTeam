366   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np, logreg\nm=logreg.LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\nXs=(X-X.mean(0))/X.std(0)\nfor lr in [0.001,0.005,0.01,0.02,0.05]:\n  th=np.zeros(Xs.shape[1]); res=None\n  for i in range(1,100001):\n    p=1/(1+np.exp(-Xs.dot(th)))\n    g=Xs.T.dot(Y-p)/Xs.shape[0]\n    pt=th.copy(); th=th+lr*g\n    d=np.linalg.norm(pt-th)\n    if d<1e-15: res=(i,d); break\n  # also print final grad norm\n  print('std norm lr',lr,'conv',res,'finaldiff',d,'gnorm',np.linalg.norm(Xs.T.dot(Y-1/(1+np.exp(-Xs.dot(th))))/Xs.shape[0]))\n"], 0xaaab1bcd1100 /* 10 vars */) = 0
