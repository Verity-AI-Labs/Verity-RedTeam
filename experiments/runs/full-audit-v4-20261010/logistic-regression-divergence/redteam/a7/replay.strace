178   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np, logreg\nm=logreg.LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\nprint('shape',X.shape,'mean',X.mean(0),'std',X.std(0))\nth=np.zeros(X.shape[1]); lr=0.1\nfor i in range(1,1000001):\n    p=1/(1+np.exp(-X.dot(th)))\n    g=X.T.dot(Y-p)/X.shape[0]\n    pt=th.copy(); th=th+lr*g\n    if i in (1000,10000,100000,500000,1000000):\n        print(i, np.linalg.norm(pt-th), np.linalg.norm(g))\n"], 0xaaaadd438f70 /* 10 vars */) = 0
