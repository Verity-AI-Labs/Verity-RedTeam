266   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np, logreg\nm=logreg.LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\nXs=(X-X.mean(0))/X.std(0)\nfor norm in [0,1]:\n  for lr in [0.1,0.5,1.0,2.0,5.0]:\n    th=np.zeros(Xs.shape[1])\n    done=None\n    for i in range(1,100001):\n        p=1/(1+np.exp(-Xs.dot(th)))\n        g=Xs.T.dot(Y-p)\n        if norm: g=g/Xs.shape[0]\n        pt=th.copy(); th=th+lr*g\n        d=np.linalg.norm(pt-th)\n        if d<1e-15: done=i; break\n    print('std','norm' if norm else 'raw','lr',lr,'->',done)\n"], 0xaaaafe8a0090 /* 10 vars */) = 0
