152   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np, logreg\nm=logreg.LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\nth=np.zeros(X.shape[1]); lr=0.1\nfor i in range(1,100001):\n    p=1/(1+np.exp(-X.dot(th)))\n    g=X.T.dot(Y-p)/X.shape[0]\n    pt=th.copy(); th=th+lr*g\n    d=np.linalg.norm(pt-th)\n    if d<1e-15:\n        print('conv',i,d); break\nelse:\n    print('no conv', i, d, 'acc', np.mean((1/(1+np.exp(-X.dot(th)))>=0.5)==Y))\n"], 0xaaaadc3f7f70 /* 10 vars */) = 0
