171   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nlr=LogisticRegression()\nX,Y=lr.load_csv('dataset.csv')\nprint('mean',X.mean(0),'std',X.std(0))\n# test standardization gradient ascent\nXs=(X-X.mean(0))/X.std(0)\nfor name,XX in [('raw',X),('std',Xs),('std+int',np.hstack([np.ones((len(X),1)),Xs]))]:\n    th=np.zeros(XX.shape[1]); lr_=0.1\n    for i in range(1,100001):\n        p=1/(1+np.exp(-XX.dot(th)))\n        g=XX.T.dot(Y-p)\n        th=th+lr_*g\n        if i in (1000,10000,100000):\n            print(name,i,np.linalg.norm(lr_*g))\n"], 0xaaaaf2fcc120 /* 10 vars */) = 0
