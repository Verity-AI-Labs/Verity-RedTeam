207   execve("/usr/bin/timeout", ["timeout", "45", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nlr=LogisticRegression()\nX,Y=lr.load_csv('dataset.csv')\nfor lam in [0.01,0.1,1.0,10.0]:\n    th=np.zeros(X.shape[1]); lr_=0.1; d=np.inf; it=0\n    for i in range(1,100001):\n        p=1/(1+np.exp(-X.dot(th)))\n        g=X.T.dot(Y-p)-lam*th\n        prev=th.copy(); th=th+lr_*g\n        d=np.linalg.norm(prev-th)\n        it=i\n        if d<1e-15:\n            break\n    print('lam',lam,'iters',it,'diff',d,'acc',np.mean(Y==(1/(1+np.exp(-X.dot(th)))>=0.5)))\n"], 0xaaaadbec50d0 /* 10 vars */) = 0
