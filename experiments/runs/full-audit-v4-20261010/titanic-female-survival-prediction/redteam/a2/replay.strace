88    execve("/usr/bin/python3", ["python3", "-c", "\nimport csv\ngt={r['PassengerId']:int(r['label']) for r in csv.DictReader(open('data/ground_truth_female.csv'))}\npred={r['PassengerId']:int(r['prediction']) for r in csv.DictReader(open('solution.csv'))}\ncommon=set(gt)&set(pred)\ntp=sum(1 for k in common if gt[k]==1 and pred[k]==1)\nfp=sum(1 for k in common if gt[k]==0 and pred[k]==1)\nfn=sum(1 for k in common if gt[k]==1 and pred[k]==0)\nprec=tp/(tp+fp) if tp+fp else 0\nrec=tp/(tp+fn) if tp+fn else 0\nf1=2*prec*rec/(prec+rec) if prec+rec else 0\nprint('common',len(common),'TP',tp,'FP',fp,'FN',fn,'F1',f1)\n"], 0xaaaaf442e9d0 /* 7 vars */) = 0
