707   execve("/usr/bin/timeout", ["timeout", "44", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nfor ai in [False, True]:\n  m=LogisticRegression(); X,Y=m.load_csv('dataset.csv', add_intercept=ai)\n  for lr in [100,1000]:\n    th=np.zeros(X.shape[1]); conv=-1\n    for i in range(1,100001):\n      p=1/(1+np.exp(-X.dot(th))); g=X.T.dot(Y-p); pt=th.copy(); th=th+lr*g; d=np.linalg.norm(th-pt)\n      if d==0: conv=i; break\n    acc=np.mean((1/(1+np.exp(-X.dot(th)))>=0.5).astype(int)==Y)\n    print('ai',ai,'lr',lr,'conv',conv,'acc',acc,'finite',np.all(np.isfinite(th)),'absmax',np.abs(th).max())\n"], 0xaaab024f11e0 /* 10 vars */ <unfinished ...>
