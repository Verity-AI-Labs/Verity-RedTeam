635   execve("/usr/bin/timeout", ["timeout", "44", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nm=LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\nfor lr in [0.1,1,10,100,1000,10000,100000]:\n  th=np.zeros(X.shape[1]); conv=-1\n  for i in range(1,100001):\n    p=1/(1+np.exp(-X.dot(th))); g=X.T.dot(Y-p); pt=th.copy(); th=th+lr*g\n    d=np.linalg.norm(th-pt)\n    if d==0 and conv<0: conv=i; break\n  acc=np.mean((1/(1+np.exp(-X.dot(th)))>=0.5).astype(int)==Y)\n  print('lr',lr,'conv',conv,'diff',d,'acc',acc,'absmax',np.abs(th).max())\n"], 0xaaab0292d130 /* 10 vars */ <unfinished ...>
