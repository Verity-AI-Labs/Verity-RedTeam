877   execve("/usr/bin/timeout", ["timeout", "44", "python3", "-c", "\nimport numpy as np\nX=np.loadtxt('dataset.csv',delimiter=',',skiprows=1,usecols=range(5))\nY=np.loadtxt('dataset.csv',delimiter=',',skiprows=1,usecols=5)\ndef sig(z):\n    out=np.empty_like(z); pos=z>=0\n    out[pos]=1/(1+np.exp(-z[pos])); ez=np.exp(z[~pos]); out[~pos]=ez/(1+ez); return out\nfor lr in [10,20,30,40,50,60,80,100,200,500,1000]:\n  th=np.zeros(X.shape[1]); conv=-1\n  for i in range(1,100001):\n    p=sig(X.dot(th)); g=X.T.dot(Y-p); pt=th.copy(); th=th+lr*g; d=np.linalg.norm(th-pt)\n    if d==0: conv=i; break\n  acc=np.mean((sig(X.dot(th))>=0.5).astype(int)==Y)\n  print('lr',lr,'conv',conv,'acc',acc,'absmax',round(float(np.abs(th).max()),2))\n"], 0xaaaacd2bc280 /* 10 vars */) = 0
