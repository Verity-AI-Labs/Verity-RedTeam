858   execve("/usr/bin/timeout", ["timeout", "44", "python3", "-c", "\nimport numpy as np\nX=np.loadtxt('dataset.csv',delimiter=',',skiprows=1,usecols=range(5))\nY=np.loadtxt('dataset.csv',delimiter=',',skiprows=1,usecols=5)\ndef sig(z):\n    out=np.empty_like(z); pos=z>=0\n    out[pos]=1/(1+np.exp(-z[pos])); ez=np.exp(z[~pos]); out[~pos]=ez/(1+ez); return out\nth=np.zeros(5)\nfor i in range(1,101):\n    p=sig(X.dot(th)); g=X.T.dot(Y-p); pt=th.copy(); th=th+1000.0*g; d=np.linalg.norm(th-pt)\n    if d==0:\n        print('exact zero at',i,'acc',np.mean((sig(X.dot(th))>=0.5).astype(int)==Y)); break\nelse: print('no exact zero', d)\nprint('probs match labels exactly:', np.array_equal(sig(X.dot(th))==1.0, Y==1.0))\n"], 0xaaaaeab5b270 /* 10 vars */) = 0
