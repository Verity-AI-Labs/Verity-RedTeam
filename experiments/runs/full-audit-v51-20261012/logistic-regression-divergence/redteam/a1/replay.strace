615   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np, warnings\nwarnings.filterwarnings('ignore')\nm=None\nfrom logreg import LogisticRegression\nL=LogisticRegression()\nX0,Y=L.load_csv('dataset.csv')\n\ndef std(a): return (a-a.mean(0))/a.std(0)\ndef inter(a): return np.hstack([np.ones((a.shape[0],1)),a])\n\ndef run(X,Y,lr,cap=100001):\n    theta=np.zeros(X.shape[1]); diff=np.inf\n    for i in range(1,cap+1):\n        p=1/(1+np.exp(-X.dot(theta)))\n        g=X.T.dot(Y-p)\n        prev=theta; theta=theta+lr*g\n        diff=np.linalg.norm(theta-prev)\n        if diff<1e-15: return i,diff\n    return None,diff\n\nvariants={'raw':(X0,Y),'inter':(inter(X0),Y),'std':(std(X0),Y),'std+inter':(inter(std(X0)),Y)}\nfor name,(X,Y) in variants.items():\n    for lr in [0.1,1,10,30,100]:\n        it,d=run(X,Y,lr)\n        print(name,'lr',lr,'->',it, d)\n"], 0xaaaaeacf2450 /* 10 vars */ <unfinished ...>
