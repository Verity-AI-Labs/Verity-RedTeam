416   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np, time\nfrom logreg import LogisticRegression\nm=LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\nXn=(X-X.mean(0))/X.std(0)\nXi=m.load_csv('dataset.csv',add_intercept=True)\n\ndef run(X,Y,lr,label,iters=100001):\n    theta=np.zeros(X.shape[1])\n    diff=np.inf\n    for i in range(iters):\n        p=1/(1+np.exp(-X.dot(theta)))\n        g=X.T.dot(Y-p)\n        prev=theta; theta=theta+lr*g\n        diff=np.linalg.norm(theta-prev)\n        if diff<1e-15:\n            print(label,'CONVERGED at',i+1,'diff',diff); return\n    print(label,'no conv final diff',diff)\n\nfor lr in [0.1,0.5,1,2,5,10]:\n    run(X,Y,lr,'raw lr%s'%lr)\nfor lr in [0.1,0.5,1,2,5,10,50]:\n    run(Xn,Y,lr,'norm lr%s'%lr)\n"], 0xaaaae6f7a300 /* 10 vars */) = 0
