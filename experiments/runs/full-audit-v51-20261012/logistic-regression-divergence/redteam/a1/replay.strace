893   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nm=LogisticRegression()\nX,Y=m.load_csv('dataset.csv')\ntheta=np.zeros(X.shape[1]); lr=0.1\nfirst=None\nfor i in range(1,100001):\n    p=1/(1+np.exp(-X.dot(theta)))\n    g=X.T.dot(Y-p)\n    prev=theta; theta=theta+lr*g\n    acc=((1/(1+np.exp(-X.dot(theta)))>=0.5).astype(int)==Y).mean()\n    if acc==1.0 and first is None:\n        first=i\n        break\nprint('first perfect acc at iter',first)\n"], 0xaaaac2985000 /* 10 vars */) = 0
