297   execve("/usr/local/sbin/python3", ["python3", "-c", "\nimport numpy as np, warnings\nwarnings.filterwarnings('ignore')\nimport logreg\nX,Y=logreg.LogisticRegression().load_csv('dataset.csv')\nm=X.shape[0]\n\ndef run(lr, lam=0.0, norm=True, iters=100000):\n    th=np.zeros(X.shape[1]); i=0\n    while True:\n        i+=1\n        pr=1/(1+np.exp(-X.dot(th)))\n        g=X.T.dot(Y-pr)\n        if norm: g=g/m\n        if lam: g=g-lam*th\n        pth=th; th=th+lr*g\n        d=np.linalg.norm(pth-th)\n        if d<1e-15: break\n        if i>iters: break\n    pred=(pr>=0.5).astype(int)\n    acc=np.mean(pred==Y)\n    return i,d,acc\nfor lam in [0.001,0.01,0.1,1.0]:\n    for lr in [0.1,0.5,1.0,2.0]:\n        try:\n            i,d,a=run(lr,lam)\n            print('lam',lam,'lr',lr,'iters',i,'diff',d,'acc',a)\n        except Exception as e:\n            print('err',lam,lr,e)\n"], 0xffffc4115288 /* 10 vars */) = -1 ENOENT (No such file or directory)
297   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np, warnings\nwarnings.filterwarnings('ignore')\nimport logreg\nX,Y=logreg.LogisticRegression().load_csv('dataset.csv')\nm=X.shape[0]\n\ndef run(lr, lam=0.0, norm=True, iters=100000):\n    th=np.zeros(X.shape[1]); i=0\n    while True:\n        i+=1\n        pr=1/(1+np.exp(-X.dot(th)))\n        g=X.T.dot(Y-pr)\n        if norm: g=g/m\n        if lam: g=g-lam*th\n        pth=th; th=th+lr*g\n        d=np.linalg.norm(pth-th)\n        if d<1e-15: break\n        if i>iters: break\n    pred=(pr>=0.5).astype(int)\n    acc=np.mean(pred==Y)\n    return i,d,acc\nfor lam in [0.001,0.01,0.1,1.0]:\n    for lr in [0.1,0.5,1.0,2.0]:\n        try:\n            i,d,a=run(lr,lam)\n            print('lam',lam,'lr',lr,'iters',i,'diff',d,'acc',a)\n        except Exception as e:\n            print('err',lam,lr,e)\n"], 0xffffc4115288 /* 10 vars */ <unfinished ...>
