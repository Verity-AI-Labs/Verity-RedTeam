141   execve("/usr/bin/timeout", ["timeout", "40", "python3", "-c", "\nimport numpy as np, warnings\nwarnings.filterwarnings('ignore')\nimport logreg\nX,Y=logreg.LogisticRegression().load_csv('dataset.csv')\n\ndef run(lr, norm=False, intercept=False, iters=100000):\n    Xi = np.hstack([np.ones((X.shape[0],1)),X]) if intercept else X\n    th=np.zeros(Xi.shape[1]); diff=np.inf; i=0\n    while True:\n        i+=1\n        pr=1/(1+np.exp(-Xi.dot(th)))\n        g=Xi.T.dot(Y-pr)\n        if norm: g=g/Xi.shape[0]\n        pth=th; th=th+lr*g\n        d=np.linalg.norm(pth-th)\n        if d<1e-15:\n            break\n        if i>iters: diff=d; break\n        diff=d\n    return i,d,th\n\nfor lr in [0.1,1.0]:\n    i,d,th=run(lr)\n    print('lr',lr,'iters',i,'diff',d,'norm',np.linalg.norm(th))\nfor lr in [0.1,1.0,10.0]:\n    i,d,th=run(lr,norm=True)\n    print('norm lr',lr,'iters',i,'diff',d)\nfor lr in [0.1,1.0]:\n    i,d,th=run(lr,intercept=True)\n    print('intercept lr',lr,'iters',i,'diff',d)\n"], 0xaaaaff5d55b0 /* 10 vars */ <unfinished ...>
