261   execve("/usr/bin/timeout", ["timeout", "40", "python3", "-c", "\nimport numpy as np, warnings\nwarnings.filterwarnings('ignore')\nimport logreg\nX,Y=logreg.LogisticRegression().load_csv('dataset.csv')\nth=np.zeros(X.shape[1]); lr=0.1\nfirst=None\nfor i in range(1,100001):\n    pr=1/(1+np.exp(-X.dot(th)))\n    g=X.T.dot(Y-pr)\n    th=th+lr*g\n    pred=(1/(1+np.exp(-X.dot(th)))>=0.5).astype(int)\n    acc=np.mean(pred==Y)\n    if acc==1.0 and first is None:\n        first=(i,np.linalg.norm(th)); print('first acc=1.0 at iter',i,'theta norm',np.linalg.norm(th)); \n    if acc==1.0 and i in (5000,10000,20000):\n        print('acc=1 at',i,'diff approx grad norm',np.linalg.norm(g))\nprint('final', first)\n"], 0xaaab039ab270 /* 10 vars */) = 0
