225   execve("/usr/bin/timeout", ["timeout", "40", "python3", "-c", "\nimport numpy as np, warnings\nwarnings.filterwarnings('ignore')\nimport logreg\nX,Y=logreg.LogisticRegression().load_csv('dataset.csv')\n\n# test separability with perceptron\nimport numpy as np\nw=np.zeros(X.shape[1]); b=0\nfor ep in range(200):\n    err=0\n    for xi,yi in zip(X,Y):\n        if yi*(xi.dot(w)+b)<=0:\n            w+=yi*xi; b+=yi; err+=1\n    if err==0:\n        print('separable, epochs',ep); break\nelse:\n    print('perceptron not converged')\n\n# decaying lr\ndef run_decay(gamma):\n    th=np.zeros(X.shape[1]); d=np.inf; i=0; lr0=0.1\n    while True:\n        i+=1\n        pr=1/(1+np.exp(-X.dot(th)))\n        g=X.T.dot(Y-pr)\n        pth=th; th=th+lr0*(gamma**i)*g\n        d=np.linalg.norm(pth-th)\n        if d<1e-15: break\n        if i>100000: break\n    pred=(1/(1+np.exp(-X.dot(th)))>=0.5).astype(int)\n    return i,d,np.mean(pred==Y),np.linalg.norm(th)\nfor gamma in [0.9995,0.999,0.9999]:\n    print('gamma',gamma,run_decay(gamma))\n"], 0xaaab06198610 /* 10 vars */ <unfinished ...>
