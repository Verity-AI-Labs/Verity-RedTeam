721   execve("/usr/bin/timeout", ["timeout", "44", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX,Y=LogisticRegression().load_csv('dataset.csv')\nfor lr in [20.0,30.0,40.0,50.0]:\n    theta=np.zeros(X.shape[1]); diff=np.inf; it=0; conv=False\n    while True:\n        it+=1; prev=theta.copy()\n        p=1.0/(1+np.exp(-X.dot(theta)))\n        g=X.T.dot(Y-p)\n        theta=theta+lr*g\n        diff=np.linalg.norm(prev-theta)\n        if diff<1e-15:\n            conv=True; break\n        if it>100000: break\n    pred=(1.0/(1+np.exp(-X.dot(theta)))>=0.5).astype(int)\n    print('lr',lr,'iters',it,'diff',diff,'conv',conv,'acc',np.mean(pred==Y),'theta',theta)\n"], 0xaaab09583240 /* 10 vars */) = 0
