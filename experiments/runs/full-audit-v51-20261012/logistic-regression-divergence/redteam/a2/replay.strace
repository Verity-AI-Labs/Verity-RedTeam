278   execve("/usr/bin/timeout", ["timeout", "40", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX,Y=LogisticRegression().load_csv('dataset.csv')\nm=len(Y)\nfor lam in [0.001,0.01,0.1,1.0]:\n  for lr in [0.1,1.0]:\n    theta=np.zeros(X.shape[1]); diff=np.inf; it=0\n    while True:\n        it+=1; prev=theta.copy()\n        p=1/(1+np.exp(-X.dot(theta)))\n        g=X.T.dot(Y-p)-lam*theta\n        theta=theta+lr*g\n        diff=np.linalg.norm(prev-theta)\n        if diff<1e-15 or it>100000: break\n    pred=(1/(1+np.exp(-X.dot(theta)))>=0.5).astype(int)\n    print('lam',lam,'lr',lr,'iters',it,'diff',diff,'acc',np.mean(pred==Y))\n"], 0xaaaae9b611b0 /* 10 vars */) = 0
