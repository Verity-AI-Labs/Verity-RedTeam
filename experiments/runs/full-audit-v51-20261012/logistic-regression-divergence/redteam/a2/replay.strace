323   execve("/usr/bin/timeout", ["timeout", "40", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX,Y=LogisticRegression().load_csv('dataset.csv')\nm=len(Y)\n# standardize features\nmu=X.mean(0); sd=X.std(0); Xs=(X-mu)/sd\nfor name,lr in [('std norm lr1',1.0),('std raw lr.1',0.1),('std raw lr1',1.0)]:\n    theta=np.zeros(Xs.shape[1]); diff=np.inf; it=0\n    while True:\n        it+=1; prev=theta.copy()\n        p=1/(1+np.exp(-Xs.dot(theta)))\n        g=Xs.T.dot(Y-p)\n        if 'norm' in name: g=g/m\n        theta=theta+lr*g\n        diff=np.linalg.norm(prev-theta)\n        if diff<1e-15 or it>100000: break\n    pred=(1/(1+np.exp(-Xs.dot(theta)))>=0.5).astype(int)\n    print(name,'iters',it,'diff',diff,'acc',np.mean(pred==Y))\n"], 0xaaaadafbb2e0 /* 10 vars */) = 0
