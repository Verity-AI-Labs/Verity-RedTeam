561   execve("/usr/bin/timeout", ["timeout", "44", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX,Y=LogisticRegression().load_csv('dataset.csv')\nfor lr in [1e-4,1e-3,1e-2,0.05,0.1,0.2,0.5,1.0]:\n    theta=np.zeros(X.shape[1]); diff=np.inf; it=0\n    while True:\n        it+=1; prev=theta\n        p=1.0/(1+np.exp(-X.dot(theta)))\n        g=X.T.dot(Y-p)\n        theta=theta+lr*g\n        diff=np.linalg.norm(prev-theta)\n        if diff<1e-15 or it>100000: break\n    print('lr',lr,'iters',it,'diff',diff)\n"], 0xaaaad49d3070 /* 10 vars */) = 0
