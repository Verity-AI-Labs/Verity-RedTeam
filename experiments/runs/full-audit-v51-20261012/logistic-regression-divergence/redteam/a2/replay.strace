233   execve("/usr/bin/timeout", ["timeout", "40", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX0,Y=LogisticRegression().load_csv('dataset.csv')\nX=LogisticRegression().add_intercept_fn(X0)\n\nfor name,lr in [('int lr.1',0.1),('int lr.01',0.01),('int lr1',1.0)]:\n    m=len(Y); theta=np.zeros(X.shape[1]); diff=np.inf; it=0\n    while True:\n        it+=1; prev=theta.copy()\n        p=1/(1+np.exp(-X.dot(theta)))\n        g=X.T.dot(Y-p)\n        theta=theta+lr*g\n        diff=np.linalg.norm(prev-theta)\n        if diff<1e-15 or it>100000: break\n    pred=(1/(1+np.exp(-X.dot(theta)))>=0.5).astype(int)\n    print(name,'iters',it,'diff',diff,'acc',np.mean(pred==Y))\n"], 0xaaaaf4926220 /* 10 vars */) = 0
