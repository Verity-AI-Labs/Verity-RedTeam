532   execve("/usr/bin/timeout", ["timeout", "45", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX,Y=LogisticRegression().load_csv('dataset.csv')\nX=X.astype(np.float32); Yf=Y.astype(np.float32)\ntheta=np.zeros(X.shape[1],dtype=np.float32); lr=np.float32(0.1)\nfor it in range(1,100001):\n    p=(1.0/(1+np.exp(-X.dot(theta)))).astype(np.float32)\n    g=X.T.dot(Yf-p).astype(np.float32)\n    prev=theta.copy(); theta=(theta+lr*g).astype(np.float32)\n    diff=float(np.linalg.norm(prev-theta))\n    if diff<1e-15:\n        print('converged',it,diff); break\nelse:\n    print('no conv',it,diff)\npred=(1.0/(1+np.exp(-X.dot(theta)))>=0.5).astype(int)\nprint('acc',np.mean(pred==Y))\n"], 0xaaaafab83240 /* 10 vars */) = 0
