182   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\n\nX,Y=LogisticRegression().load_csv('dataset.csv')\ndef run(gradfn, lr, limit=100000, conv=1e-15):\n    m=len(Y)\n    theta=np.zeros(X.shape[1])\n    diff=np.inf\n    it=0\n    while True:\n        it+=1\n        prev=theta.copy()\n        g=gradfn(X,Y,theta,m)\n        theta=theta+lr*g\n        diff=np.linalg.norm(prev-theta)\n        if diff<conv: break\n        if it>limit: break\n    return it,diff,theta\n\ndef g_norm(X,Y,t,m):\n    p=1/(1+np.exp(-X.dot(t)))\n    return X.T.dot(Y-p)/m\n\ndef g_raw(X,Y,t,m):\n    p=1/(1+np.exp(-X.dot(t)))\n    return X.T.dot(Y-p)\n\nfor name,g,lr in [('raw lr.1',g_raw,0.1),('norm lr1',g_norm,1.0),('norm lr.1',g_norm,0.1)]:\n    it,diff,th=run(g,lr)\n    pred=(1/(1+np.exp(-X.dot(th)))>=0.5).astype(int)\n    acc=np.mean(pred==Y)\n    print(name,'iters',it,'diff',diff,'acc',acc)\n"], 0xffffd1688b48 /* 10 vars */) = 0
