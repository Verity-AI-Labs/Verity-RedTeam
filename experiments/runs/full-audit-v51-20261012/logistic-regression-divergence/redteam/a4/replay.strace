617   execve("/usr/bin/timeout", ["timeout", "60", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX,Y=LogisticRegression().load_csv('dataset.csv')\n\ndef run(sched, niter=100000):\n    theta=np.zeros(X.shape[1])\n    for t in range(1,niter+1):\n        p=theta.copy()\n        probs=1/(1+np.exp(-np.clip(X.dot(theta),-500,500)))\n        lr=sched(t)\n        theta=theta+lr*X.T.dot(Y-probs)\n        d=np.linalg.norm(p-theta)\n        if d<1e-15:\n            pred=(1/(1+np.exp(-np.clip(X.dot(theta),-500,500)))>=0.5).astype(int)\n            return t,d,np.mean(pred==Y)\n    pred=(1/(1+np.exp(-np.clip(X.dot(theta),-500,500)))>=0.5).astype(int)\n    return niter,d,np.mean(pred==Y)\n\nfor name,s in [('lr=0.1/(1+t/1000)', lambda t:0.1/(1+t/1000)),\n               ('lr=0.1/(1+t/10000)', lambda t:0.1/(1+t/10000)),\n               ('lr=0.1*(0.999999**t)', lambda t:0.1*(0.999999**t)),\n               ('lr=0.1/(1+t*0.1)', lambda t:0.1/(1+t*0.1))]:\n    print(name, run(s))\n"], 0xaaab0051b5a0 /* 10 vars */) = 0
