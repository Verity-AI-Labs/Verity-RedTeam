331   execve("/usr/bin/timeout", ["timeout", "60", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX,Y=LogisticRegression().load_csv('dataset.csv')\ndef run(lr, X2, niter=100000):\n    theta=np.zeros(X2.shape[1])\n    for it in range(1,niter+1):\n        p=theta.copy()\n        probs=1/(1+np.exp(-X2.dot(theta)))\n        g=X2.T.dot(Y-probs)\n        theta=theta+lr*g\n        d=np.linalg.norm(p-theta)\n        if d<1e-15:\n            return it,d\n    return niter,d\nprint('raw lr .1', run(0.1,X))\nprint('raw lr 1', run(1.0,X))\nXs=(X-X.mean(0))/X.std(0)\nprint('std lr .1', run(0.1,Xs))\nprint('std lr 1', run(1.0,Xs))\n"], 0xaaaacff4f190 /* 10 vars */) = 0
