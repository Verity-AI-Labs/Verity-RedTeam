538   execve("/usr/bin/timeout", ["timeout", "60", "python3", "-c", "\nimport numpy as np\nfrom logreg import LogisticRegression\nX,Y=LogisticRegression().load_csv('dataset.csv')\n\n# normalized gradient test\ndef run(lr, niter=100000):\n    theta=np.zeros(X.shape[1]); n=X.shape[0]\n    for it in range(1,niter+1):\n        p=theta.copy()\n        probs=1/(1+np.exp(-np.clip(X.dot(theta),-500,500)))\n        g=X.T.dot(Y-probs)/n\n        theta=theta+lr*g\n        d=np.linalg.norm(p-theta)\n        if d<1e-15: return it,d\n    return niter,d\nfor lr in [0.1,1,5,10,50]:\n    print('norm lr',lr,run(lr))\n"], 0xaaaab9741100 /* 10 vars */) = 0
