299   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np\nX = np.loadtxt('dataset.csv', delimiter=',', skiprows=1, usecols=[0,1,2,3,4])\nY = np.loadtxt('dataset.csv', delimiter=',', skiprows=1, usecols=[5])\n# perceptron to test separability\ntheta=np.zeros(5)\nfor it in range(200000):\n    acc=0\n    for i in range(len(Y)):\n        if Y[i]*(X[i].dot(theta))<=0:\n            theta=theta+Y[i]*X[i]\n            acc+=1\n    if acc==0:\n        print('separable at iter',it); break\nelse:\n    print('not separable (perceptron stalled), final misclassified', acc)\n# margins\ntheta=np.zeros(5)\nfor it in range(100000):\n    p=1/(1+np.exp(-X.dot(theta)))\n    theta=theta+0.1*X.T.dot(Y-p)\nmargins=Y*X.dot(theta)\nprint('min margin', margins.min(), 'max |theta|', np.abs(theta).max())\n"], 0xaaab1166c360 /* 10 vars */) = 0
