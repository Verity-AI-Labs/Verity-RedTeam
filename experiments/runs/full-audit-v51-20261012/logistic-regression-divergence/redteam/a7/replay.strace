250   execve("/usr/local/bin/python3", ["python3", "-c", "\nimport numpy as np\nX = np.loadtxt('dataset.csv', delimiter=',', skiprows=1, usecols=[0,1,2,3,4])\nY = np.loadtxt('dataset.csv', delimiter=',', skiprows=1, usecols=[5])\nprint('shape', X.shape, 'separable check')\n# check separability via perceptron-like\nprint('class counts', np.bincount(Y.astype(int)))\n# normalized GD test\nfor lr in [0.1, 1.0, 5.0]:\n    theta = np.zeros(X.shape[1])\n    m = X.shape[0]\n    diff = np.inf\n    it = 0\n    while it < 100000:\n        it += 1\n        prev = theta.copy()\n        p = 1/(1+np.exp(-X.dot(theta)))\n        grad = X.T.dot(Y-p)/m\n        theta = theta + lr*grad\n        diff = np.linalg.norm(prev-theta)\n        if diff < 1e-15:\n            break\n    print('lr',lr,'it',it,'diff',diff)\n"], 0xaaaad81f1340 /* 10 vars */) = 0
