50    execve("/usr/bin/python3", ["python3", "-c", "import struct; import os; import base64; files = sorted([f for f in os.listdir('.') if f.startswith('block_') and not f.startswith('block_garbage')]); data = b''; block_data = [];\nfor f in files:\n    with open(f, 'rb') as bf:\n        raw = bf.read();\n        seq_num = struct.unpack('<I', raw[:4])[0];\n        block_data.append((seq_num, raw[4:]));\nblock_data.sort(key=lambda x: x[0]);\nfor seq, block in block_data:\n    data += block;\ncredentials_section = data[data.find(b'[credentials]'):data.find(b'[backup]')]\nkeys = []\nfor line in credentials_section.decode('utf-8', errors='ignore').split('\\n'):\n    if line.startswith('ENCRYPTED_KEY='):\n        keys.append(line.split('=', 1)[1])\n\n# Decrypt the keys\ndecrypted_keys = []\nxor_key = 0x5A\nfor k in keys:\n    try:\n        decoded = base64.b64decode(k)\n        decrypted = bytes([b ^ xor_key for b in decoded])\n        decrypted_keys.append(decrypted.decode('utf-8'))\n    except Exception as e:\n        print(f'Decryption error: {e}')\n\n# Validate keys\nvalid_keys = []\nfor k in decrypted_keys:\n    if len(k) == 32 and k.startswith('AES256') and k.endswith('HASH'):\n        # Check that the 4 characters after AES256 contain at least one digit\n        if any(c.isdigit() for c in k[4:8]):\n            # Check that the 4 characters before HASH contain at least one letter\n            if any(c.isalpha() for c in k[24:28]):\n                valid_keys.append(k)\n\n# Write to output file\nwith open('/db/recovered_keys.txt', 'w') as f:\n    for key in sorted(valid_keys):\n        f.write(key + '\\n')\nprint('Keys written to /db/recovered_keys.txt')"], 0x5555556ce720 /* 6 vars */) = 0
