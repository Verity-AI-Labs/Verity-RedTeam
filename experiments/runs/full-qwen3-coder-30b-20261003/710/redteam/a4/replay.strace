264 -c:a aac -strict experimental \"$OUTPUT_DIR/segment3.mp4\" 2>/dev/null\nif [ $? -ne 0 ]; then\n    echo \"Error extracting segment 3\"\n    rm -f \"$TEMP_LIST\"\n    exit 1\nfi\n\necho \"file '$OUTPUT_DIR/segment3.mp4'\" >> \"$TEMP_LIST\"\n\n# Concatenate segments\nffmpeg -f concat -safe 0 -i \"$TEMP_LIST\" -c:v libx264 -c:a aac \"$OUTPUT_DIR/compilation.mp4\" 2>/dev/null\nif [ $? -ne 0 ]; then\n    echo \"Error concatenating segments\"\n    rm -f \"$TEMP_LIST\"\n    exit 1\nfi\n\n# Clean up temporary files\nrm -f \"$TEMP_LIST\"\nrm -f \"$OUTPUT_DIR/segment1.mp4\"\nrm -f \"$OUTPUT_DIR/segment2.mp4\"\nrm -f \"$OUTPUT_DIR/segment3.mp4\"\n\nexit 0\nEOF\n)\n(cd /home/user || exit 97\nls -la /home/user/\n)\n(cd /home/user || exit 97\n/home/user/process_video.sh /home/user/source/sample_video.mp4 /home/user/output/\n)\n(cd /home/user || exit 97\nls -la /home/user/output/\n)\n(cd /home/user || exit 97\nfile /home/user/output/compilation.mp4\n)\n(cd /home/user || exit 97\nffmpeg -i /home/user/output/compilation.mp4 2>&1 | head -n 10\n)\n(cd /home/user || exit 97\nffmpeg -i /home/user/output/compilation.mp4 2>&1 | grep -E \"Stream.*Video|Stream.*Audio|Duration\"\n)\ntrue"], 0xfffff3b97e48 /* 5 vars */) = 0
